    \uBC14\uB78C\uC5D0 \uD754\uB4E4\uB9AC\uBA70 \uC704\uD0DC\uB86D\uAC8C \uAE5C\uBE61\uC774\uACE0,
    \uC5B4\uC2B4\uD478\uB808\uD55C \uADF8\uB9BC\uC790\uB9CC\uC744 \uB4DC\uB9AC\uC6B4\uB2E4.\n\uB530\uB73B\uD568\uBCF4\uB2E4\uB294
    \uD76C\uB9DD\uC758 \uD754\uC801\uCC98\uB7FC \uB290\uAEF4\uC9C0\uB294 \uBD88\uBE5B.\n\uC870\uC6A9\uD788
    \uD0C0\uC624\uB974\uBA70, \uAE08\uBC29\uC774\uB77C\uB3C4 \uAEBC\uC9C8 \uAC83\uCC98\uB7FC
    \uC18D\uC0AD\uC778\uB2E4.\n\n\u201C\uD0C0\uACE0 \uC788\uC9C0\uB9CC, \uC624\uB798\uAC00\uC9C4
    \uBABB\uD560 \uAC83\uC774\uB2E4.\u201D"
